# Public URL (used for canonical links, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://mjazo.pk

# Submissions store. Without these, submissions are written to .data/submissions.jsonl (dev only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Core engine (bookings, pros, the money ledger, the event outbox: supabase/migrations/0005_core.sql).
# DATABASE_URL: Supabase's *transaction pooler* string (port 6543), set by
#   node scripts/setup-supabase.mjs --migrate
# Without it in production the core is off and bookings are plain submissions, as before.
# Locally the core runs on PGlite in .data/pglite with no setup; CORE_DB=off switches it off.
DATABASE_URL=
# Optional: Supabase's database CA certificate (Database settings → SSL → download), so the
# server's identity is verified as well as the connection encrypted. \n for line breaks is fine.
DATABASE_CA_CERT=
CORE_DB=

# Ops email notification for every booking / waitlist / application / enquiry
RESEND_API_KEY=
OPS_EMAIL=
OPS_FROM="Mjazo <ops@mjazo.pk>"

# --- Mjazo AI (Phase 1) -------------------------------------------------------------------
# Claude API key: powers the Concierge, Ghar Scan and Home Pulse personalisation.
# Without it those features fall back gracefully (WhatsApp hand-off / rule-based plan).
ANTHROPIC_API_KEY=
# Optional model overrides (defaults: Sonnet 5.5 for chat + vision, Haiku 4.5 for short copy)
AI_MODEL_CONCIERGE=
AI_MODEL_VISION=
AI_MODEL_FAST=

# WhatsApp Cloud API (Meta) for the Concierge on WhatsApp. Webhook URL: https://<site>/api/whatsapp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Speech-to-text for WhatsApp voice notes (OpenAI-compatible transcription endpoint)
STT_API_KEY=
STT_API_URL=
STT_MODEL=

# --- Mjazo AI (Phase 2): staff apps -------------------------------------------------------
# Mission control (/ops) has no passcode any more: staff sign in with their own email on the CMS
# sign-in (Supabase + cms_users) and get an operations role (Dispatcher, Support, Finance,
# Recruiter) in /admin/people. Locally without Supabase, a local person of any role signs in.
# SESSION_SECRET: a long random string that signs the /pro app's sessions (pros sign in with
# phone + PIN or an emailed link; the phone app gets the same session as a bearer token). Without
# it in production the pro app stays switched off. "node scripts/setup-supabase.mjs --migrate"
# makes it and stores it in Vercel. Changing it signs every pro out.
SESSION_SECRET=
# Lets an external scheduler (e.g. every 5 minutes) run the Safety Guardian sweep:
# GET https://<site>/api/cron/safety with header  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Optional model for the ops analyst ("Ask AI"); defaults to Opus 5.5
AI_MODEL_OPS=

# --- Mjazo AI (Phase 3) -------------------------------------------------------------------
# Shaadi Orchestrator planner (defaults to Opus 5.5). Glam Mirror runs on the customer's phone
# (MediaPipe from jsDelivr + Google's model files) and only uses the Claude key to write Look Cards.
# Phase 3 data also lives in ops_docs: wedding plans, ratings (on jobs), the audit log, leakage
# check-ins, and brief photos (deleted when each visit ends).
AI_MODEL_PLANNER=
# Phase 2 data (jobs, pros, applicants, complaints) lives in Supabase table ops_docs:
# run supabase/migrations/0003_ops.sql. Without Supabase, Vercel keeps it only temporarily in /tmp.

# --- CMS (/admin) ------------------------------------------------------------------------------
# Supabase: the same project as above. The public URL and anon key let editors sign in from the
# browser (email + password or a magic link) and upload media straight to Storage.
# Run supabase/migrations/0004_cms.sql once (CMS tables + the public "media" storage bucket).
# `node scripts/setup-supabase.mjs` runs every migration and adds these settings to Vercel.
# The new-style keys work too: sb_publishable_... here, sb_secret_... as SUPABASE_SERVICE_ROLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The first Owners: one email, or several separated by commas. They sign in with "Email me a
# sign-in link" (their account is made then) and invite the team from /admin/people.
CMS_OWNER_EMAIL=
# Owners, Admins and Finance must use two-step sign-in (an authenticator app). Set to false only while
# setting up; anyone who has already set it up is still asked for their code.
CMS_MFA_REQUIRED=
# Scheduled publishing: point a 5-minute pinger at GET https://<site>/api/cron/cms-publish with
# header  Authorization: Bearer <CRON_SECRET>  (the same CRON_SECRET as the Safety Guardian).
# Optional: Google PageSpeed Insights key, for more audits per day from /admin/seo.
PAGESPEED_API_KEY=
